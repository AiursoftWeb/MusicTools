@model Aiursoft.MusicTools.Models.DashboardViewModels.MelodyExcerptQuizViewModel
<div class="listening-hero mb-4">
    <span class="listening-eyebrow">@Localizer["LISTEN · NOTICE · UNDERSTAND"]</span>
    <h1>@Localizer["Melody Excerpt Quiz"]</h1>
    <p>@Localizer["Hear a short musical context, focus on one marked measure, and choose its matching notation. Three or four plausible versions, one clear listening task. No account needed."]</p>
    <div class="d-flex gap-4 flex-wrap">
        <span><strong>@Model.AvailableQuestions.Count</strong> @Localizer["published questions"]</span>
        <span>@Localizer["One note or one rhythm pattern — no search for scattered mistakes"]</span>
    </div>
</div>
@if (Model.AvailableQuestions.Count == 0)
{
    <div class="card"><div class="card-body text-center py-5">
        <i data-lucide="music" class="mb-3"></i>
        <h2>@Localizer["The stage is being prepared"]</h2>
        <p class="text-muted">@Localizer["There are no published listening questions yet. Come back after a musician has reviewed the first set."]</p>
    </div></div>
}
else
{
    <form id="listening-practice" class="card" method="post" asp-controller="Listening" asp-action="Start">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-8">
                    <label for="question-picker" class="form-label">@Localizer["Choose your challenge"]</label>
                    <select id="question-picker" name="questionId" class="form-select">
                        @foreach (var question in Model.AvailableQuestions)
                        {
                            <option value="@question.Id">@question.Title · @Localizer[question.Skill.ToString()] · @Localizer["Level"] @question.Difficulty</option>
                        }
                    </select>
                </div>
                <div class="col-md-4"><button id="start-practice" class="btn btn-primary w-100">@Localizer["Start / new attempt"]</button></div>
            </div>
            <p class="small text-muted mt-3 mb-0">@Localizer["Replay the recording as needed. Select one answer and submit; your first submitted answer counts. Notation and explanation remain available for learning afterward."]</p>
        </div>
    </form>
    <p id="practice-error" class="text-danger" role="alert"></p>
    <section id="practice-stage" hidden>
        <div class="card"><div class="card-body">
            <div class="d-flex justify-content-between gap-3 flex-wrap">
                <h2 id="practice-title" class="h4"></h2>
                <label for="practice-zoom">@Localizer["Notation zoom"] <input id="practice-zoom" type="range" min="0.6" max="1.4" step="0.1" value="0.85" /></label>
            </div>
            <p id="practice-prompt" class="lead"></p>
            <p id="practice-focus" class="small text-muted"></p>
            <audio id="practice-audio" controls preload="auto" class="w-100"></audio>
            <button id="replay-target" type="button" class="btn btn-outline-primary mt-2" disabled>@Localizer["Replay target measure"]</button>
            <p id="focus-playback-status" class="listening-focus-panel p-3 mt-3" role="status"></p>
            <p id="practice-status" role="status" class="small text-muted mt-2"></p>
        </div></div>
        <fieldset id="practice-options">
            <legend class="h5">@Localizer["Which score matches the recording?"]</legend>
            <p class="small text-muted">@Localizer["Only the target measure is shown. All versions differ at the same location; the source version is not always the answer."]</p>
            <div id="practice-cards" class="row g-4"></div>
        </fieldset>
        <div class="d-flex gap-3 align-items-center my-4">
            <button id="submit-answer" type="button" class="btn btn-primary" disabled>@Localizer["Submit answer"]</button>
            <span id="practice-score" class="text-muted" aria-live="polite"></span>
        </div>
        <div id="practice-result" class="listening-result mb-4" aria-live="polite" hidden></div>
    </section>
}
@* ReSharper disable once Razor.SectionNotResolved *@
@section styles { <link rel="stylesheet" href="~/styles/listening.css" asp-append-version="true" /> }
@* ReSharper disable once Razor.SectionNotResolved *@
@section scripts { <script type="module" src="~/dist/scripts/listeningPractice.js" asp-append-version="true"></script> }
<partial name="_ListeningText" />
