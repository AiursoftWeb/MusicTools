@inject IViewLocalizer Localizer

<div class="container py-4">
    <h1 class="h3">@Localizer["Four-Part Harmony Dictation"]</h1>
    <div id="start-overlay" class="card">
        <div class="card-body">
            <p>@Localizer["Listen to 3 bars of 4-part harmony and identify the correct progression."]</p>
            <label class="form-label" for="harmony-key">@Localizer["Key"]</label>
            <select class="form-select w-auto mb-3" id="harmony-key">
                <optgroup label="@Localizer["Major Key"]">
                    @foreach (var key in new[] { "C", "G", "F", "D", "B♭" })
                    {
                        <option value="@key.Replace("♭", "b")">@key</option>
                    }
                </optgroup>
                <optgroup label="@Localizer["Minor Key"]">
                    @foreach (var key in new[] { "A", "E", "D", "B", "G" })
                    {
                        <option value="@(key)m">@(key)m</option>
                    }
                </optgroup>
            </select>
            <label class="form-label" for="harmony-mode">@Localizer["Exercise"]</label>
            <select class="form-select w-auto mb-3" id="harmony-mode">
                <option value="outer">@Localizer["Identify the soprano and bass"]</option>
                <option value="dictation">@Localizer["Enter the chords and inversions"]</option>
            </select>
            <div class="form-check mb-3">
                <input type="checkbox" class="form-check-input" id="tonic-cue" checked />
                <label class="form-check-label" for="tonic-cue">@Localizer["Sound the tonic chord before the phrase"]</label>
            </div>
            <p class="text-secondary">@Localizer["Audio plays max 3 times."] @Localizer["1 minute time limit per question."]</p>
            <button id="btn-start" type="button" class="btn btn-primary">@Localizer["Start Exam"]</button>
        </div>
    </div>

    <div id="game-board" hidden>
        <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
            <strong id="current-key"></strong>
            <span title="@Localizer["Time remaining"]"><i class="align-middle" data-lucide="clock" aria-hidden="true"></i> <span id="timer-text">01:00</span></span>
            <span title="@Localizer["Play Harmony"]">♫ <span id="play-count-text">0 / 3</span></span>
            <span class="text-success">✓ <span id="correct-count">0</span></span>
            <span class="text-danger">✗ <span id="wrong-count">0</span></span>
            <button type="button" id="btn-settings" class="btn btn-outline-secondary ms-auto">@Localizer["Back to settings"]</button>
        </div>
        <div id="review-controls" hidden>
            <div class="d-flex flex-wrap align-items-end gap-3 mb-2">
                <div id="review-comparison" hidden>
                    <label for="review-source" class="form-label">@Localizer["Compare"]</label>
                    <select id="review-source" class="form-select">
                        <option value="answer">@Localizer["Correct answer"]</option>
                        <option value="choice">@Localizer["Your choice"]</option>
                    </select>
                </div>
                <div>
                    <label for="review-voice" class="form-label">@Localizer["Listen to"]</label>
                    <select id="review-voice" class="form-select">
                        <option value="all">@Localizer["All four voices"]</option>
                        <option value="soprano">@Localizer["Soprano"]</option>
                        <option value="alto">@Localizer["Alto"]</option>
                        <option value="tenor">@Localizer["Tenor"]</option>
                        <option value="bass">@Localizer["Bass"]</option>
                    </select>
                </div>
            </div>
            <p id="review-difference" class="mb-2" hidden></p>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <button id="btn-play-harmony" type="button" class="btn btn-primary">@Localizer["Play Harmony"]</button>
            <button id="btn-next" type="button" class="btn btn-outline-primary" hidden>@Localizer["Next Question"]</button>
            <span id="harmony-status" role="status"></span>
        </div>
        <div id="dictation-panel" hidden>
            <div class="row g-3 mb-3">
                @for (var measure = 0; measure < 3; measure++)
                {
                    <fieldset class="col-12 col-lg-4">
                        <legend class="h5">@string.Format(@Localizer["Measure {0}"].Value, measure + 1)</legend>
                        <div class="row g-2">
                            @for (var beat = 0; beat < (measure == 2 ? 1 : 4); beat++)
                            {
                                var slot = measure * 4 + beat;
                                <div class="col-6">
                                    <label for="chord-@slot" class="form-label">@string.Format(@Localizer["Beat {0}"].Value, beat + 1)</label>
                                    <select id="chord-@slot" class="form-select dictation-chord" aria-describedby="mark-@slot"></select>
                                    <small id="mark-@slot" class="dictation-mark"></small>
                                </div>
                            }
                        </div>
                    </fieldset>
                }
            </div>
            <button type="button" class="btn btn-primary" id="submit-dictation">@Localizer["Check my chords"]</button>
            <div id="dictation-score" class="harmony-score bg-white rounded" aria-label="@Localizer["Correct answer"]" hidden></div>
        </div>
        <div id="score-options" class="row g-3">
            @for (var i = 0; i < 4; i++)
            {
                <div class="col-12 col-xl-6">
                    <div class="card h-100 mb-0 option-card">
                        <div class="card-body p-2 p-sm-3">
                            <button type="button" class="btn btn-outline-primary choose-option" disabled>@Localizer["Option"] @((char)('A' + i))</button>
                            <span class="option-result ms-2 fw-bold"></span>
                            <div class="harmony-score mt-2 bg-white rounded" role="img" aria-label="@Localizer["Option"] @((char)('A' + i))"></div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<div id="loc-data" hidden>
    <span data-key="correct">@Localizer["Correct!"]</span>
    <span data-key="wrong">@Localizer["Wrong!"]</span>
    <span data-key="timeout">@Localizer["Time's up!"]</span>
    <span data-key="loading">@Localizer["Loading..."]</span>
    <span data-key="error">@Localizer["Could not load the exercise. Please try again."]</span>
    <span data-key="audio-error">@Localizer["Audio could not play. Press Play Harmony to retry."]</span>
    <span data-key="prompt">@Localizer["Listen for the soprano and bass, then choose the matching score."]</span>
    <span data-key="dictation-prompt">@Localizer["Choose the chord and inversion at each beat."]</span>
    <span data-key="dictation-result">@Localizer["{0} of 9 chords correct."].Value</span>
    <span data-key="location">@Localizer["Measure {0}, beat {1}"].Value</span>
    <span data-key="compare-beats">@Localizer["Listen for the difference at: {0}"].Value</span>
    <span data-key="stop">@Localizer["Stop"]</span>
    <span data-key="answer">@Localizer["Correct answer: {0}"].Value</span>
</div>

@* ReSharper disable once Razor.SectionNotResolved *@
@section scripts {
    <script type="module" src="~/dist/scripts/fourPartHarmony.js" asp-append-version="true"></script>
}

@* ReSharper disable once Razor.SectionNotResolved *@
@section styles {
    <style>
        /* The sidebar can finish resizing after OSMD has laid out the measures. */
        .harmony-score svg { max-width: 100%; height: auto; }
    </style>
}
