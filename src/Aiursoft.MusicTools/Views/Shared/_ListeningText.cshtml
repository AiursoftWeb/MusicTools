<div id="loc-data" hidden>
    <span data-key="measure">@Localizer["Select measure position {0}", "{0}"]</span>
    <span data-key="preparing">@Localizer["Preparing audio…"]</span>
    <span data-key="selection-changed">@Localizer["Selection changed. Prepare audio again."]</span>
    <span data-key="audio-ready">@Localizer["Ready. Press play to listen."]</span>
    <span data-key="loading-focused">@Localizer["Loading the short versions…"]</span>
    <span data-key="ready-focused">@Localizer["Listen to the target measure, then choose the matching short version. Any approved version may be played."]</span>
    <span data-key="replay-target">@Localizer["Replay target measure"]</span>
    <span data-key="focus-playing">@Localizer["Target measure is playing — listen here."]</span>
    <span data-key="focus-range">@Localizer["Target measure: {0}–{1} seconds. You can replay just this measure.", "{0}", "{1}"]</span>
    <span data-key="focus-location">@Localizer["Only compare measure position {0}, pitched note {1}. For rhythm, compare that note and the next.", "{0}", "{1}"]</span>
    <span data-key="load-failed">@Localizer["Could not load this question. Please try again."]</span>
    <span data-key="correct">@Localizer["Correct!"]</span>
    <span data-key="incorrect">@Localizer["Keep listening."]</span>
    <span data-key="answer">@Localizer["Answer: {0}", "{0}"]</span>
    <span data-key="session">@Localizer["{0} / {1} correct this session", "{0}", "{1}"]</span>
    <span data-key="replay">@Localizer["Replay and compare the scores, or start a new attempt."]</span>
    <span data-key="audio-failed">@Localizer["The recording could not be loaded. Start a new attempt or try again later."]</span>
    <span data-key="parse-failed">@Localizer["The score could not be parsed."]</span>
    <span data-key="request-failed">@Localizer["Request failed ({0})", "{0}"]</span>
</div>
