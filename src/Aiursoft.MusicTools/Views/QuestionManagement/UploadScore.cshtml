@model Aiursoft.MusicTools.Models.QuestionManagementViewModels.UploadScoreViewModel

<div class="row mb-2 mb-xl-3">
    <div class="col-auto d-none d-sm-block">
        <h3>@Localizer["Upload New Score"]</h3>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="UploadScore" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label">@Localizer["Score Name"]</label>
                <input asp-for="Name" class="form-control" placeholder="@Localizer["e.g. Mozart Sonata No. 16"]" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Author" class="form-label">@Localizer["Composer / arranger"]</label>
                <input asp-for="Author" class="form-control mb-3" />
                <label class="form-label">@Localizer["MusicXML file"]</label>
                <vc:file-upload
                    asp-for="ScorePath"
                    subfolder="score"
                    allowed-extensions="mxl xml musicxml"
                    is-vault="true"
                    max-size-in-mb="20">
                </vc:file-upload>
                <span asp-validation-for="ScorePath" class="text-danger"></span>
                <div class="alert alert-info mt-3">
                    <h4 class="h6">@Localizer["Have a MuseScore project instead?"]</h4>
                    <p class="mb-2">@Localizer["Export your .mscz or .mscx project as MusicXML on your computer. No server conversion is needed."]</p>
                    <a asp-action="ExportMusicXml" class="btn btn-outline-primary btn-sm">@Localizer["Show me how to export"]</a>
                </div>
                <p class="small text-muted mt-2">@Localizer["Originals are kept private. Import runs in the background; you can preview the normalized score before creating questions."]</p>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary">@Localizer["Upload and Save"]</button>
                <a asp-action="Index" class="btn btn-link">@Localizer["Cancel"]</a>
            </div>
        </form>
    </div>
</div>

@* ReSharper disable once Razor.SectionNotResolved *@
@section styles {
    <link rel="stylesheet" href="~/node_modules/dropify/dist/css/dropify.min.css" />
    <link rel="stylesheet" href="~/styles/uploader.css" />
}

@* ReSharper disable once Razor.SectionNotResolved *@
@section scripts {
    <script src="~/node_modules/dropify/dist/js/dropify.min.js"></script>
    <script>
        document.addEventListener('change', event => {
            const input = event.target;
            if (input instanceof HTMLInputElement && input.type === 'file' &&
                /\.(mscz|mscx)$/i.test(input.files?.[0]?.name ?? '')) {
                event.stopImmediatePropagation();
                input.value = '';
                window.location.assign('@Url.Action("ExportMusicXml")');
            }
        }, true);
    </script>
}
